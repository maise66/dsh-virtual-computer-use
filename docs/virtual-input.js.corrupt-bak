const NAMED_KEYS = {
  // 缂栬緫閿?  backspace: 0x08, back: 0x08, bs: 0x08,
  tab: 0x09,
  enter: 0x0d, return: 0x0d, cr: 0x0d, '\n': 0x0d, '\r': 0x0d,
  shift: 0x10,
