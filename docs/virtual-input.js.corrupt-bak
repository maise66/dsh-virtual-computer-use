/**
 * 鏈ā鍧椾緷璧?`lib/native.js` 鐨?`loadWin32()`銆? *
 * 璇ュ嚱鏁版槸鍗曚緥銆佹瘡涓嚱鏁?*鐙珛** try/catch锛堝崟涓粦瀹氬け璐ュ彧璁拌繘 `loaded.failures`
 * 骞惰繑鍥?`undefined`锛夛紝鍙湁 5 涓牳蹇冪粦瀹氬叏缂烘椂鎵嶅垽瀹?FFI 涓嶅彲鐢ㄣ€傛墍浠ヨ繖閲岀洿鎺? * 娑堣垂鍗冲彲锛屼笉鍐嶅仛浠讳綍琛ョ粦鈥斺€旇ˉ缁戜細鎺╃洊 native.js 鐨勭湡瀹為棶棰樸€? *
 * 鏈ā鍧楅澶栫敤鍒扮殑銆乶ative.js 涔熷鍑虹殑缁戝畾锛歅ostMessageW / SendMessageW /
 * GetCursorPos / MapVirtualKeyW / GetKeyState / GetAsyncKeyState / ClientToScreen /
 * ScreenToClient / IsWindow / IsWindowVisible / IsWindowEnabled / IsIconic /
 * IsHungAppWindow / GetForegroundWindow / GetWindowThreadProcessId /
 * SetForegroundWindow / ShowWindow / SetWindowPos / AttachThreadInput /
 * GetClassNameW / GetWindowTextW / GetCurrentThreadId銆? *
 * 娉細杩涚▼鏄犲儚鏌ヨ锛圤penProcess / QueryFullProcessImageNameW锛塶ative.js 鏈鍑猴紝
 * 鍥犳 `probeWindow()` 鐨?`image` 瀛楁鍦ㄧ己灏戣繖浜涚粦瀹氭椂涓?`undefined`锛? * 鏁忔劅搴﹀惎鍙戝紡浼氳嚜鍔ㄨ烦杩囧熀浜庢槧鍍忓悕鐨勫垽鏂紙璇﹁ describeSensitivity锛夈€? */

/** 鍐呴儴锛氭嬁鍒扮粦瀹氾紝鎴栧湪涓嶅彲鐢ㄦ椂鎶涗竴涓甫 dshReason 鐨勯敊璇€傚叕寮€ API 鍏ㄩ儴鍖呬簡 try銆?*/
function requireBindings() {
  const loaded = loadWin32();
  if (loaded.reason !== undefined) {
    const error = new Error(loaded.reason);
    error.dshReason = loaded.reason;
    throw error;
  }
  return loaded;
}

